generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  uuid          String     @id @default(uuid()) @db.Uuid
  name          String     @db.VarChar(255)
  status        Boolean    @default(true)
  imageUrl      String?    @map("image_url") @db.Text
  parentUuid    String?    @map("parent_uuid") @db.Uuid
  parent        Category?  @relation("CategoryChildren", fields: [parentUuid], references: [uuid], onDelete: Cascade)
  subcategories Category[] @relation("CategoryChildren")
  products      Product[]

  @@index([status])
  @@index([parentUuid])
  @@map("categories")
}

model Admin {
  uuid           String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(120)
  email          String    @unique @db.VarChar(255)
  password       String    @db.VarChar(255)
  token          String?   @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at")

  @@map("admins")
}


model Product {
  uuid         String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  description  String?  @db.Text
  price        Decimal  @db.Decimal(12, 2)
  salePrice    Decimal? @map("sale_price") @db.Decimal(12, 2)
  quantity     Int      @default(0)
  status       Boolean  @default(true)
  imageUrl     String?        @map("image_url") @db.Text
  categoryUuid String         @map("category_uuid") @db.Uuid
  category     Category       @relation(fields: [categoryUuid], references: [uuid], onDelete: Cascade)
  images       ProductImage[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([categoryUuid])
  @@index([status])
  @@index([createdAt])
  @@map("products")
}


model ProductImage {
  uuid        String   @id @default(uuid()) @db.Uuid
  productUuid String   @map("product_uuid") @db.Uuid
  imageUrl    String   @map("image_url") @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  product     Product  @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@index([productUuid, sortOrder])
  @@map("product_images")
}
