generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  uuid          String     @id @default(uuid()) @db.Uuid
  name          String     @db.VarChar(255)
  status        Boolean    @default(true)
  imageUrl      String?    @map("image_url") @db.Text
  parentUuid    String?    @map("parent_uuid") @db.Uuid
  parent        Category?  @relation("CategoryChildren", fields: [parentUuid], references: [uuid], onDelete: Cascade)
  subcategories Category[] @relation("CategoryChildren")
  products      Product[]

  @@index([status])
  @@index([parentUuid])
  @@map("categories")
}

model Admin {
  uuid           String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(120)
  email          String    @unique @db.VarChar(255)
  password       String    @db.VarChar(255)
  token          String?   @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at")

  @@map("admins")
}

model Product {
  uuid          String                 @id @default(uuid()) @db.Uuid
  name          String                 @db.VarChar(255)
  slug          String                 @unique @db.VarChar(255)
  description   String?                @db.Text
  price         Decimal                @db.Decimal(12, 2)
  salePrice     Decimal?               @map("sale_price") @db.Decimal(12, 2)
  quantity      Int                    @default(0)
  status        Boolean                @default(true)
  imageUrl      String?                @map("image_url") @db.Text
  categoryUuid  String                 @map("category_uuid") @db.Uuid
  category      Category               @relation(fields: [categoryUuid], references: [uuid], onDelete: Cascade)
  images        ProductImage[]
  cartItems     CustomerCartItem[]
  wishlistItems CustomerWishlistItem[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([categoryUuid])
  @@index([status])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  uuid        String  @id @default(uuid()) @db.Uuid
  productUuid String  @map("product_uuid") @db.Uuid
  imageUrl    String  @map("image_url") @db.Text
  sortOrder   Int     @default(0) @map("sort_order")
  product     Product @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@index([productUuid, sortOrder])
  @@map("product_images")
}

model Customer {
  uuid          String                 @id @default(uuid()) @db.Uuid
  name          String                 @db.VarChar(120)
  email         String                 @unique @db.VarChar(255)
  password      String                 @db.VarChar(255)
  phone         String?                @db.VarChar(30)
  createdAt     DateTime               @default(now()) @map("created_at")
  orders        Order[]
  cartItems     CustomerCartItem[]
  cartMerges    CustomerCartMerge[]
  wishlistItems CustomerWishlistItem[]
  addresses     CustomerAddress[]

  @@map("customers")
}

model CustomerAddress {
  uuid         String   @id @default(uuid()) @db.Uuid
  customerUuid String   @map("customer_uuid") @db.Uuid
  label        String   @db.VarChar(10)
  name         String   @db.VarChar(120)
  phone        String   @db.VarChar(30)
  address      String   @db.Text
  city         String   @db.VarChar(120)
  state        String   @db.VarChar(120)
  pincode      String   @db.VarChar(20)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerUuid], references: [uuid], onDelete: Cascade)

  @@index([customerUuid, createdAt])
  @@map("customer_addresses")
}

model Order {
  uuid          String      @id @default(uuid()) @db.Uuid
  orderNumber   String      @unique @map("order_number") @db.VarChar(40)
  customerUuid  String      @map("customer_uuid") @db.Uuid
  customer      Customer    @relation(fields: [customerUuid], references: [uuid], onDelete: Restrict)
  name          String      @db.VarChar(120)
  phone         String      @db.VarChar(30)
  address       String      @db.Text
  city          String      @db.VarChar(120)
  state         String      @db.VarChar(120)
  pincode       String      @db.VarChar(20)
  notes         String?     @db.Text
  subtotal      Decimal     @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  status        String      @default("placed") @db.VarChar(30)
  paymentMethod String      @default("cod") @map("payment_method") @db.VarChar(30)
  paymentStatus String      @default("pending") @map("payment_status") @db.VarChar(30)
  createdAt     DateTime    @default(now()) @map("created_at")
  items         OrderItem[]

  @@index([customerUuid, createdAt])
  @@map("orders")
}

model OrderItem {
  uuid        String  @id @default(uuid()) @db.Uuid
  orderUuid   String  @map("order_uuid") @db.Uuid
  order       Order   @relation(fields: [orderUuid], references: [uuid], onDelete: Cascade)
  productUuid String  @map("product_uuid") @db.Uuid
  productName String  @map("product_name") @db.VarChar(255)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  @@index([orderUuid])
  @@map("order_items")
}

// Persistent customer carts: one product row per customer, independent of browser.
model CustomerCartItem {
  uuid         String   @id @default(uuid()) @db.Uuid
  customerUuid String   @map("customer_uuid") @db.Uuid
  productUuid  String   @map("product_uuid") @db.Uuid
  quantity     Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  customer     Customer @relation(fields: [customerUuid], references: [uuid], onDelete: Cascade)
  product      Product  @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@unique([customerUuid, productUuid])
  @@index([customerUuid])
  @@map("customer_cart_items")
}

// One-time receipts prevent duplicate guest-cart additions after network retries.
model CustomerCartMerge {
  uuid         String   @id @default(uuid()) @db.Uuid
  customerUuid String   @map("customer_uuid") @db.Uuid
  mergeKey     String   @map("merge_key") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  customer     Customer @relation(fields: [customerUuid], references: [uuid], onDelete: Cascade)

  @@unique([customerUuid, mergeKey])
  @@map("customer_cart_merges")
}

model CustomerWishlistItem {
  uuid         String   @id @default(uuid()) @db.Uuid
  customerUuid String   @map("customer_uuid") @db.Uuid
  productUuid  String   @map("product_uuid") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  customer     Customer @relation(fields: [customerUuid], references: [uuid], onDelete: Cascade)
  product      Product  @relation(fields: [productUuid], references: [uuid], onDelete: Cascade)

  @@unique([customerUuid, productUuid])
  @@index([customerUuid, createdAt])
  @@map("customer_wishlist_items")
}
