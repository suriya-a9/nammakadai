# Replace with your PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nammakadai?schema=public"
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_token

# Use a long random secret in production.
ADMIN_JWT_SECRET="replace-with-a-long-random-secret"

# Use a new random value; customer sessions are distinct from admin sessions.
CUSTOMER_JWT_SECRET="replace-with-another-long-random-secret"
